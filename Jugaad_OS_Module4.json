      "parameters": {
        "jsCode": "const users = $input.all();\n\n// Sort by total_xp descending\nconst sorted = users\n  .map(u => u.json)\n  .sort((a, b) => b.total_xp - a.total_xp);\n\n// Rank emojis\nconst medals = ['🥇', '🥈', '🥉'];\n\n// Build leaderboard text\nconst leaderboardLines = sorted.map((user, i) => {\n  const medal = medals[i] || `${i + 1}.`;\n  return `${medal} ${user.name}\\n   XP: ${user.total_xp} | Rank: ${user.rank_title}\\n   Daily: ${user.daily_xp} | Streak: ${user.current_streak} days`;\n}).join('\\n\\n');\n\nconst message = `🏆 WEEKLY LEADERBOARD\nHafta bhar ki mehnat ka hisaab! 😈\n\n${leaderboardLines}\n\nTop pe rehna hai toh commit karte raho bhai! 💪`;\n\n// Get all chat_ids to send to\nconst chatIds = sorted.map(u => u.chat_id);\n\nreturn [{\n  json: {\n    message,\n    chatIds,\n    topUser: sorted[0]?.name || 'Nobody',\n    totalUsers: sorted.length,\n  }\n}];"
      },
