    {
      "parameters": {
        "method": "POST",
        "url": "https://leetcode.com/graphql",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "User-Agent",
              "value": "Mozilla/5.0"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"query\": \"query($username:String!){matchedUser(username:$username){submitStats:submitStatsGlobal{acSubmissionNum{difficulty count}}userCalendar{streak totalActiveDays}}recentAcSubmissionList(username:$username,limit:20){title timestamp}}\",\n  \"variables\": {\n    \"username\": \"Anubhav03042004\"\n  }\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        800,
        144
      ],
      "id": "ec5cb770-bed0-4c6c-ab25-b3061c9f444d",
      "name": "HTTP Request1",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const user = $('Loop Over Items').item.json;\nconst githubEvents = $('HTTP Request').all();\nconst lcData = $('HTTP Request1').first().json;\n\nconst now = new Date();\nconst todayStart = new Date(now.getFullYear(), now.getMonth(), now.getDate()).getTime();\nconst weekStart = Date.now() - 7 * 24 * 60 * 60 * 1000;\n\n// GitHub XP\nconst pushEvents = githubEvents.filter(e => e.json.type === 'PushEvent');\nconst todayCommits = pushEvents\n  .filter(e => new Date(e.json.created_at).getTime() >= todayStart)\n  .reduce((sum, e) => sum + (e.json.payload?.commits?.length || 1), 0);\nconst weekCommits = pushEvents\n  .filter(e => new Date(e.json.created_at).getTime() >= weekStart)\n  .reduce((sum, e) => sum + (e.json.payload?.commits?.length || 1), 0);\nconst githubXP = todayCommits * 30;\n\n// LeetCode XP\nconst recentSubs = lcData?.data?.recentAcSubmissionList || [];\nconst stats = lcData?.data?.matchedUser?.submitStats?.acSubmissionNum || [];\nconst totalSolved = stats.find(s => s.difficulty === 'All')?.count || 0;\nconst streak = lcData?.data?.matchedUser?.userCalendar?.streak || 0;\nconst todayTimestamp = Math.floor(todayStart / 1000);\nconst solvedToday = recentSubs.filter(s => parseInt(s.timestamp) >= todayTimestamp).length;\nconst leetcodeXP = solvedToday * 50;\n\n// Streak bonus\nconst streakBonus = streak > 0 ? 20 : 0;\nconst dailyXP = githubXP + leetcodeXP + streakBonus;\n\n// Rank function\nfunction getRank(totalXP) {\n  if (totalXP >= 3000) return 'Don Hai Tu 🏆';\n  if (totalXP >= 2000) return 'Mogambo Khush Hua 😂';\n  if (totalXP >= 1200) return 'Don ka Dost 👑';\n  if (totalXP >= 800)  return 'Virat Mode On 🔥';\n  if (totalXP >= 500)  return 'Baazigar 🃏';\n  if (totalXP >= 300)  return 'Bumrah in Making 🎳';\n  if (totalXP >= 100)  return 'Gabbar ka Chamcha 😈';\n  return 'Naya Khiladi 🏏';\n}\n\nreturn [{\n  json: {\n    chat_id: user.chat_id,\n    name: user.name,\n    daily_xp: dailyXP,\n    github_xp: githubXP,\n    leetcode_xp: leetcodeXP,\n    streak_bonus: streakBonus,\n    today_commits: todayCommits,\n    week_commits: weekCommits,\n    solved_today: solvedToday,\n    total_solved: totalSolved,\n    streak,\n    is_lazy: dailyXP === 0,\n  }\n}];"
      },
