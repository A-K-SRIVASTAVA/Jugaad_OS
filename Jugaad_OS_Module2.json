    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst internshalaItem = items.find(i => i.json.source === \"Internshala\");\nconst freelanceItem = items.find(i => i.json.source === \"Reddit r/forhire\");\nconst placementItem = items.find(i => i.json.source?.includes(\"Unstop\"));\nconst remoteItem = items.find(i => i.json.source?.includes(\"RemoteOK\"));\n\nconst internships = (internshalaItem?.json?.internships || []).slice(0, 3);\nconst gigs = (freelanceItem?.json?.gigs || []).slice(0, 3);\nconst placements = (placementItem?.json?.placements || []).slice(0, 3);\nconst remoteJobs = (remoteItem?.json?.remote_jobs || []).slice(0, 3);\n\n// Ultra safe clean — removes everything except alphanumeric, spaces, newlines\nconst safe = (str) => (str || \"\")\n  .replace(/&amp;/g, \"and\")\n  .replace(/&lt;/g, \"less than\")\n  .replace(/&gt;/g, \"greater than\")\n  .replace(/[^\\w\\s\\n\\r.,@:/\\-💰🏢💻🎯🌍💪🔥📅]/g, \" \")\n  .replace(/\\s+/g, \" \")\n  .trim();\n\nconst msg1 = \"💰 AAJ KA PAISA JUGAAD!\\n📅 \" + new Date().toLocaleDateString(\"en-IN\") + \"\\n\\nSubah subah fresh opportunities aa gayi! 🔥\";\n\nconst msg2 = \"🏢 INTERNSHIPS\\n\\n\" + (internships.length > 0\n  ? internships.map((j, i) =>\n      (i+1) + \". \" + safe(j.title) + \"\\n\" +\n      \"Company: \" + safe(j.company) + \"\\n\" +\n      \"Stipend: \" + safe(j.stipend || \"Check site\") + \"\\n\" +\n      \"Location: \" + safe(j.location || \"WFH\") + \"\\n\" +\n      \"Link: \" + (j.link || \"\")\n    ).join(\"\\n\\n\")\n  : \"Koi nahi aaj\");\n\nconst msg3 = \"💻 FREELANCE GIGS\\n\\n\" + (gigs.length > 0\n  ? gigs.map((g, i) =>\n      (i+1) + \". \" + safe(g.title) + \"\\n\" +\n      \"Budget: \" + safe(g.budget || \"Negotiable\") + \"\\n\" +\n      \"Link: \" + (g.link || \"\")\n    ).join(\"\\n\\n\")\n  : \"Koi nahi aaj\") +\n  \"\\n\\n🎯 PLACEMENTS\\n\\n\" + (placements.length > 0\n  ? placements.map((p, i) =>\n      (i+1) + \". \" + safe(p.title) + \"\\n\" +\n      \"Company: \" + safe(p.company) + \"\\n\" +\n      \"Location: \" + safe(p.location || \"India\") + \"\\n\" +\n      \"Link: \" + (p.link || \"\")\n    ).join(\"\\n\\n\")\n  : \"Koi nahi aaj\");\n\nconst msg4 = \"🌍 REMOTE JOBS\\n\\n\" + (remoteJobs.length > 0\n  ? remoteJobs.map((r, i) =>\n      (i+1) + \". \" + safe(r.title) + \"\\n\" +\n      \"Company: \" + safe(r.company) + \"\\n\" +\n      \"Salary: \" + safe(r.salary || \"Not listed\") + \"\\n\" +\n      \"Link: \" + (r.link || \"\")\n    ).join(\"\\n\\n\")\n  : \"Koi nahi aaj\") +\n  \"\\n\\nKal bhi bhejunga! Keep applying bhai 💪\";\n\n// Clean all messages of problematic chars for Telegram\nconst cleanMsg = (str) => str\n  .replace(/[_*[\\]()~`>#+=|{}.!]/g, ' ')\n  .replace(/\\s+/g, ' ')\n  .trim();\n\nconst finalMsg1 = cleanMsg(msg1);\nconst finalMsg2 = cleanMsg(msg2);\nconst finalMsg3 = cleanMsg(msg3);\nconst finalMsg4 = cleanMsg(msg4);\n\nreturn [{\n  json: {\n    msg1: finalMsg1,\n    msg2: finalMsg2,\n    msg3: finalMsg3,\n    msg4: finalMsg4,\n    totalCount: internships.length + gigs.length + placements.length + remoteJobs.length,\n  }\n}];\n"
      },
